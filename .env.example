# ===========================================================================
# AMPARO · variables de entorno
#
# Las mismas van en .env.local (local) y en el panel de Vercel (producción).
# Ojo: ANTHROPIC_API_KEY hace falta EN EL BUILD, no solo en tiempo de
# ejecución — el texto de la tutela se genera al construir y queda horneado
# en el HTML estático.
# ===========================================================================

# --- Supabase -------------------------------------------------------------
# Settings → API. La secreta reemplaza a la vieja service_role.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SECRET_KEY=

# --- Modelos --------------------------------------------------------------
ANTHROPIC_API_KEY=          # redacción y extracción · claude-opus-5
OPENAI_API_KEY=             # transcripción · whisper-1

# --- Operación ------------------------------------------------------------
# Decide si el BUILD toca la red.
#
#   false → el build llama a Claude y hornea la redacción real en el HTML.
#           Es lo que queremos en producción: el texto bueno, servido estático.
#   true  → el build no llama a nadie y queda el texto determinístico. Sirve
#           para desplegar sin llaves, o si la API está caída a la hora mala.
#
# En los dos casos el sitio desplegado funciona sin red: las páginas de los
# casos de referencia son HTML estático. Lo único que necesita conexión en
# vivo es el micrófono.
MODO_FIXTURE=false

# Congela la fecha de corte. Sin esto, "pasaron 34 días" cambia cada día que
# amanece y el video deja de coincidir con lo que se ve en pantalla.
FECHA_CORTE=2026-08-16
